[Unit]
Description=FlexRadio 6000-series to MQTT/Home Assistant bridge
Documentation=https://github.com/yourorg/flex2mqtt
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=flex2mqtt
Group=flex2mqtt

# Config file location; override with systemctl edit flex2mqtt if needed.
EnvironmentFile=-/etc/flex2mqtt/flex2mqtt.env
ExecStart=/usr/local/bin/flex2mqtt -config /etc/flex2mqtt/config.toml

# Restart on any failure (radio reboot, broker outage, crash). Backoff is
# handled by StartSec + systemd's linear backoff up to the rate limit.
Restart=on-failure
RestartSec=5

# Resource and security hardening. flex2mqtt needs only:
#   - outbound TCP to the radio (4992) and MQTT broker
#   - a local UDP socket (4991) to receive the meter stream
#   - a UDP socket for discovery broadcast (4992)
# All ports are >1024, so no elevated capabilities are required.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=true
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
RemoveIPC=true
CapabilityBoundingSet=
AmbientCapabilities=
# Allow writing the (text) log to stderr; nothing else needs disk.
ReadWritePaths=/var/lib/flex2mqtt
# journald captures stderr.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=flex2mqtt

[Install]
WantedBy=multi-user.target
